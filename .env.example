# ============================================================
#  Konfigurasi HDKS  -  JANGAN di-commit / jangan dibagikan
#  Salin file ini jadi .env lalu isi HDKS_LOGIN_URL.
# ============================================================

# --- YANG PERLU DIGANTI TIAP HARI ---------------------------
# Paste URL halaman utama HDKS sesudah login. sSession-nya
# diambil otomatis dan dipakai untuk ROH, INT, dan RT.
# Boleh dikosongkan: jalankan.bat akan meminta lewat prompt URL>
# dan menuliskannya balik ke sini.
HDKS_LOGIN_URL=

# Tanggal data (YYYY-MM-DD). Kosongkan = hari ini.
HDKS_TANGGAL=

# --- JARANG BERUBAH -----------------------------------------
HDKS_BASE_URL=https://hdks.pln-jawa-bali.co.id/~hdks/app4/system.php

# Folder berisi ROH.xlsx / INT.xlsx / RT.xlsx - tujuan utama data mentah.
# File-nya harus sudah ada; skrip menimpa sheet pertamanya, tidak membuat baru.
RAW_DIR=raw

# Sejak v4, workbook diisi lewat Power Query yang membaca folder raw/,
# bukan ditulis skrip. Biarkan false - lihat catatan di README/riwayat commit.
TULIS_KE_WORKBOOK=false

# Hanya dipakai kalau TULIS_KE_WORKBOOK=true. JANGAN diarahkan ke
# shofwans_tools_v4.xlsx: penulisan lewat openpyxl akan menghapus
# Power Query di dalamnya secara permanen.
EXCEL_PATH=

# Isi manual hanya kalau mau menimpa session dari HDKS_LOGIN_URL.
HDKS_SESSION=

# Server HDKS pakai sertifikat internal -> false
HDKS_VERIFY_SSL=false
